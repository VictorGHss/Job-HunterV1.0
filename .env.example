# ==============================================================================
# JOB HUNTER - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores antes de iniciar.
# NUNCA versione o arquivo .env real ou segredos no Git.

# --- Ambiente ---
ENVIRONMENT=development
APP_NAME="Job Hunter"
APP_VERSION="0.1.0"
PLANNED_HOSTNAME=https://jobhunter.ctrls.dev.br

# --- Portas Locais (escolhidas para evitar conflitos com outros projetos) ---
BACKEND_PORT=8090
FRONTEND_PORT=5180

# --- Banco de Dados PostgreSQL (Container Interno) ---
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter_user
# Substitua por uma senha forte gerada localmente (ex: openssl rand -hex 24)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_LOCAL_DB_PASSWORD

# URL de conexão utilizada pelo Backend (dentro do Docker Compose usa o host 'db')
DATABASE_URL=postgresql+psycopg://jobhunter_user:CHANGE_ME_STRONG_LOCAL_DB_PASSWORD@db:5432/jobhunter

# --- Segurança e Sessão ---
# Gere uma chave secreta forte (mínimo 32 bytes, ex: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_SECRET_KEY_BEFORE_RUNNING
SESSION_COOKIE_NAME=jh_session
CSRF_COOKIE_NAME=jh_csrf
SESSION_EXPIRE_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Rate Limiting e Proxy Confiável ---
# CIDRs confiáveis de proxies reversos (loopback + sub-redes Docker privadas).
# Headers de encaminhamento (X-Forwarded-For / X-Real-IP) só são aceitos se o peer direto estiver nesta lista.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Habilite true SOMENTE quando o sistema estiver exclusivamente atrás do Cloudflare Tunnel (borda Cloudflare)
TRUST_CF_CONNECTING_IP=false
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_ACCOUNT_IP_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_COOLDOWN_SECONDS=300

# --- CORS ---
# Lista separada por vírgula das origens permitidas (nunca utilize '*' com credenciais)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,https://jobhunter.ctrls.dev.br

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
